-- datapath.vhd
-------------------------------------------------------------------------
-- DESCRIPTION: 
-- putting the pieces together
--
-- NOTES:
-- 
-------------------------------------------------------------------------

library IEEE;
use IEEE.std_logic_1164.all;
use IEEE.numeric_std.all;

entity tb_datapath is
	generic(gCLK_HPER   : time := 50 ns);
end tb_datapath;


architecture behavior of tb_datapath is
  constant cCLK_PER  : time := gCLK_HPER * 2;


component datapath is
    port(CLK 	: in std_logic;
	 RST 	: in std_logic;
	 rdsel 	: in std_logic_vector(4 downto 0);
	 rs1sel : in std_logic_vector(4 downto 0);
	 rs2sel : in std_logic_vector(4 downto 0);
	 rs1 	: out std_logic_vector(31 downto 0);
	 rs2 	: out std_logic_vector(31 downto 0);
	 imm	: in std_logic_vector(31 downto 0);	-- 32 bits now, but later it will be 12 bits and 20 bits separate.
	 nAdd_Sub : in std_logic;
	 ALUSrc	: in std_logic;
	 ALUOut : out std_logic_vector(31 downto 0)
	 );
end component;

signal s_CLK, s_RST, s_nAdd_Sub, s_ALUSrc : std_logic;
signal s_imm, s_rs1, s_rs2 : std_logic_vector(31 downto 0) := (others => '0');
signal s_ALUOut : std_logic_vector(31 downto 0);
signal s_rdsel, s_rs1sel, s_rs2sel : std_logic_vector(4 downto 0) := (others => '0');
signal one : std_logic_vector(0 downto 0) := "1";

begin

  DUT : datapath
    port map(
	 CLK 	=> s_CLK,
	 RST 	=> s_RST,
	 rdsel 	=> s_rdsel,
	 rs1sel => s_rs1sel,
	 rs2sel => s_rs2sel,
	 rs1 	=> s_rs1,
	 rs2 	=> s_rs2,
	 imm	=> s_imm,
	 nAdd_Sub => s_nAdd_Sub,
	 ALUSrc	=> s_ALUSrc,
	 ALUOut => s_ALUOut
	);


P_CLK: process
  begin
    s_CLK <= '0';
    wait for gCLK_HPER;
    s_CLK <= '1';
    wait for gCLK_HPER;
  end process;
  
  -- Testbench process  
  P_TB: process
  begin

	-- reset everything initially
	s_RST 	<= '1';
	wait for cCLK_PER;
	s_RST	<= '0';
	s_imm  	<= x"00000000";
	s_rdsel <= "00000";
	s_nAdd_Sub <= '0';
	s_ALUSrc   <= '0';
	--s_ALUOut   <= x"00000000";
	wait for cCLK_PER;
	


	-- begin testing


	-- addi x1-x10, zero, 1-10
	-- using the loop isnt necessary but it helps
	wait for cCLK_PER/2;
    for i in 0 to 9 loop
	
	
	s_imm   <= std_logic_vector(resize(unsigned(s_imm) + unsigned(one), 32));
	s_rdsel <= std_logic_vector(resize(unsigned(s_rdsel) + unsigned(one), 5));
	s_rs1sel	<= "00000";
	s_rs2sel	<= "00000";
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '1';

	wait for cCLK_PER;

    end loop;


	-- add x11, x1, x2
	s_rdsel 	<= "01011";
	s_rs1sel	<= "00001";
	s_rs2sel	<= "00010";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- sub x12, x11, x3
	s_rdsel 	<= "01100";
	s_rs1sel	<= "01011";
	s_rs2sel	<= "00011";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '1';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- add x13, x12, x4
	s_rdsel 	<= "01101";
	s_rs1sel	<= "01100";
	s_rs2sel	<= "00100";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- sub x14, x13, x5
	s_rdsel 	<= "01110";
	s_rs1sel	<= "01101";
	s_rs2sel	<= "00101";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '1';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- add x15, x14, x6
	s_rdsel 	<= "01111";
	s_rs1sel	<= "01110";
	s_rs2sel	<= "00110";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- sub x16, x15, x7
	s_rdsel 	<= "10000";
	s_rs1sel	<= "01111";
	s_rs2sel	<= "00111";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '1';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- add x17, x16, x8
	s_rdsel 	<= "10001";
	s_rs1sel	<= "10000";
	s_rs2sel	<= "01000";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- sub x18, x17, x9
	s_rdsel 	<= "10010";
	s_rs1sel	<= "10001";
	s_rs2sel	<= "01001";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '1';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- add x19, x18, x10
	s_rdsel 	<= "10011";
	s_rs1sel	<= "10010";
	s_rs2sel	<= "01010";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- addi x20, x0, -35
	s_rdsel 	<= "10100";
	s_rs1sel	<= "00000";
	s_rs2sel	<= "00000";
	s_imm		<= x"FFFFFFDC";	--+35 = x00000023 so -35 = FFFFFFDC
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '1';
	wait for cCLK_PER;

	-- add x21, x19, x20
	s_rdsel 	<= "10101";
	s_rs1sel	<= "10011";
	s_rs2sel	<= "10100";
	s_imm		<= x"00000001";
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '0';
	wait for cCLK_PER;

	-- lui x22, 0xFEED2
	s_rdsel 	<= "10110";
	s_rs1sel	<= "00000";
	s_rs2sel	<= "00000";
	s_imm		<= x"FEED2000";	-- just loading a 32 bit value for now
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '1';
	wait for cCLK_PER;

	-- addi x22, x22, 0x050
	s_rdsel 	<= "10110";
	s_rs1sel	<= "00000";
	s_rs2sel	<= "00000";
	s_imm		<= x"00000050";	-- just loading a 32 bit value for now
	s_nAdd_Sub	<= '0';
	s_ALUSrc	<= '1';
	wait for cCLK_PER;

    

    wait;
  end process;

end behavior;