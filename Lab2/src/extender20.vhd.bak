-- extender20.vhd
-------------------------------------------------------------------------
-- DESCRIPTION: 
-- extend things yay
-- specifically this one appends 12 0 bits
-- NOTES:
-- 
-------------------------------------------------------------------------

library IEEE;
use IEEE.std_logic_1164.all;
use IEEE.numeric_std.all;


entity extender20 is
   port(
	ctl	: in std_logic := '0';
	imm	: in std_logic_vector(19 downto 0);
	ext_imm	: out std_logic_vector(31 downto 0) := (others => '0')
	);
end extender20;



architecture dataflow of extender20 is




begin

	ext_imm <= std_logic_vector(shift_left(resize(unsigned(imm), 32), 12));
	 	   


end dataflow;